# Frontend public API target.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Analytics 4 measurement ID (Admin > Data streams > your web stream). Used on every page except /admin,
# and only in production builds, so local development never sends data. It is baked in at build time:
# change it, then run `npm run build` again.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R5XF1VD9VF

