PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/quiz-bot
FRONTEND_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
JWT_SECRET=dev-only-secret-change-me

# Set these to seed the first admin account in local development.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=STEM-JUPEB Admin

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADMIN_EMAILS=
GOOGLE_ADMIN_DOMAINS=
GOOGLE_REDIRECT_URI=
GOOGLE_ADMIN_REDIRECT_URI=
GOOGLE_STUDENT_REDIRECT_URI=

# Optional AI marking. AI_PROVIDER is "openai" (default) or "ollama" (free, self-hosted).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Local model through Ollama. Set it up with scripts/setup-ollama-vps.sh. Keep port 11434 closed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false
# true = fail a submission instead of falling back to keyword marking (OPENAI_REVIEW_REQUIRED still works).
AI_REVIEW_REQUIRED=false
# Concurrent AI requests (default 1 for ollama, 4 for openai) and per-request timeout.
AI_CONCURRENCY=
AI_TIMEOUT_MS=120000
# How long submit waits for marking before answering "grading" and letting the app poll (ms).
GRADING_WAIT_MS=15000

# Optional welcome and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TLCHub <no-reply@mytlchub.com>
SMTP_REPLY_TO=
SMTP_ENVELOPE_FROM=
SMTP_DKIM_DOMAIN=
SMTP_DKIM_SELECTOR=
SMTP_DKIM_PRIVATE_KEY=
